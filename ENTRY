;; Put whatever you want to be called before server running here

;; The deployment's own settings file is optional.  Everything torikomi needs to
;; know now has a default in `(torikomi preferences)', read from the
;; environment, so a fresh clone starts without any file at all.  `env.scm' is
;; still honoured for a deployment that predates that; it is only looked for,
;; and only loaded, when it is there -- which is what keeps a checkout without
;; one from printing a failure on every start.
(when (file-exists? "env.scm")
  (display "\nloading env.scm\n")
  (catch #t
    (lambda () (load "env.scm"))
    (lambda (key . args)
      (display (format #f "error loading env.scm: ~a: ~a" key args)))))
